# Copy to .env (repo root — Docker Compose and drizzle-kit both read it)
# and .env.local inside apps/web for `npm run dev`.

# ---- database -------------------------------------------------------------
# Local (docker compose up -d db):
DATABASE_URL=postgres://athletic:athletic@localhost:5433/athletic
# Neon (production) — the driver switches automatically on the hostname:
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/athletic?sslmode=require

# ---- auth -----------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web)
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
#                          https://your-domain/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Needed locally; Vercel sets this for you.
AUTH_URL=http://localhost:3000

# Local testing without Google credentials: adds a "Skip sign-in (dev)" button
# that creates a real user and a real session. Ignored unless NODE_ENV is not
# production and VERCEL is unset, so it cannot reach a deployment.
# AUTH_DEV_BYPASS=1

# Host port for the local Postgres container (5432 is often taken).
DB_PORT=5433
